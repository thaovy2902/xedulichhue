# ─── Booking form notifications ────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# On Vercel: Project → Settings → Environment Variables (same names).
# The form works as long as at least ONE channel (email or Telegram) is set up.

# Email (Gmail). GMAIL_APP_PASSWORD is a 16-character App Password, NOT your
# normal Gmail password: Google Account → Security → 2-Step Verification (on)
# → App passwords → create one named "Website".
GMAIL_USER=taxidulichhue@gmail.com
GMAIL_APP_PASSWORD=
# Where new bookings are sent (defaults to GMAIL_USER if empty)
BOOKING_EMAIL_TO=

# Telegram. Create a bot with @BotFather (/newbot) to get the token.
# Chat ID: send any message to your bot (or add it to a group), then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}.
# Group chat IDs are negative numbers, e.g. -1001234567890.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── SEO ───────────────────────────────────────────────────────────────────
# Google Search Console → Add property → HTML tag method → copy the
# content="..." value only.
GOOGLE_SITE_VERIFICATION=
